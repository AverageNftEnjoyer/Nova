{
  "name": "nova-hud",
  "version": "0.71.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/next-runner.mjs dev",
    "build": "node scripts/next-runner.mjs build",
    "start": "node scripts/next-runner.mjs start",
    "lint": "eslint .",
    "notify:send": "node scripts/send-notification.mjs",
    "electron:dev": "concurrently \"cross-env BROWSER=none NEXT_TELEMETRY_DISABLED=1 npm run dev\" \"wait-on http://127.0.0.1:3000 --timeout 30000 --interval 500 --window 1000 && cross-env NEXT_TELEMETRY_DISABLED=1 electron .\"",
    "electron:prod": "concurrently \"cross-env NEXT_TELEMETRY_DISABLED=1 npm run start\" \"wait-on http://127.0.0.1:3000 --timeout 30000 --interval 500 --window 1000 && cross-env NEXT_TELEMETRY_DISABLED=1 electron .\"",
    "version:sync": "node scripts/sync-version.mjs",
    "electron:prepare-runtime": "node scripts/prepare-runtime-resources.mjs",
    "electron:build": "npm run version:sync && npm run build && npm run electron:prepare-runtime && electron-builder",
    "electron:build:win": "npm run version:sync && npm run build && npm run electron:prepare-runtime && electron-builder --win --x64",
    "electron:publish:win": "npm run version:sync && npm run build && npm run electron:prepare-runtime && electron-builder --win --x64 --publish always",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "test:smoke:headed": "playwright test --headed",
    "package:size": "node scripts/measure-package.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jsdom": "^28.1.0",
    "next": "^16.1.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@lobehub/icons": "^4.4.3",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.49.1",
    "@polymarket/clob-client": "^5.7.0",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.167.2",
    "@types/turndown": "^5.0.6",
    "@xyflow/react": "^12.10.1",
    "ai": "6.0.38",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint-config-next": "^16.1.6",
    "gsap": "^3.14.2",
    "lucide-react": "^0.454.0",
    "motion": "^12.34.0",
    "postcss": "^8.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.9",
    "three": "^0.167.1",
    "turndown": "^7.2.2",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "viem": "^2.47.0",
    "wait-on": "^9.1.0",
    "zod": "3.25.76"
  }
}
